{
  "$comment": "Shared semver-range vectors. Both the iOS host (ModuleCompatibilityTests) and the TypeScript contracts (npm test) assert every case; a Kotlin host must pass the same file.",
  "satisfies": [
    {"range": "0.1.0", "version": "0.1.0", "expected": true},
    {"range": "0.1.0", "version": "0.1.7", "expected": true},
    {"range": "0.1.0", "version": "0.2.0", "expected": false},
    {"range": "0.1.2", "version": "0.1.1", "expected": false},
    {"range": "1.2.0", "version": "1.9.0", "expected": true},
    {"range": "1.2.0", "version": "2.0.0", "expected": false},
    {"range": "^0.1.0", "version": "0.1.9", "expected": true},
    {"range": "^0.0.3", "version": "0.0.4", "expected": false},
    {"range": "^1.0.0", "version": "1.4.2", "expected": true},
    {"range": "~1.2.0", "version": "1.2.9", "expected": true},
    {"range": "~1.2.0", "version": "1.3.0", "expected": false},
    {"range": ">=0.1.0", "version": "3.0.0", "expected": true},
    {"range": ">=0.1.0 <0.3.0", "version": "0.2.5", "expected": true},
    {"range": ">=0.1.0 <0.3.0", "version": "0.3.0", "expected": false},
    {"range": ">0.1.0", "version": "0.1.0", "expected": false},
    {"range": "<=1.0.0", "version": "1.0.0", "expected": true},
    {"range": "=0.1.0", "version": "0.1.0", "expected": true},
    {"range": "0.1.x", "version": "0.1.4", "expected": true},
    {"range": "0.1.x", "version": "0.2.0", "expected": false},
    {"range": "*", "version": "9.9.9", "expected": true},
    {"range": "^0.1.0 || ^1.0.0", "version": "1.3.0", "expected": true},
    {"range": "^0.1.0 || ^1.0.0", "version": "0.2.0", "expected": false},
    {"range": "0.1.0", "version": "0.1.0-beta.1", "expected": false},
    {"range": "garbage", "version": "0.1.0", "expected": false},
    {"range": "", "version": "0.1.0", "expected": false},
    {"range": "0.1", "version": "0.1.0", "expected": false},
    {"range": "0.1.0", "version": "not-a-version", "expected": false},
    {"range": "01.0.0", "version": "1.0.0", "expected": false}
  ]
}
