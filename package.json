{
  "name": "modula-native",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "runtime",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "npm run start --workspace @modula/runtime",
    "typecheck": "tsc --noEmit -p runtime/tsconfig.json",
    "test": "tsx --test runtime/tests/*.test.ts",
    "verify:boundary": "python3 scripts/verify-boundaries.py"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.20.6",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2"
  },
  "codegenConfig": {
    "name": "ModulaHostSpec",
    "type": "modules",
    "jsSrcsDir": "packages/host-bridge/src/specs",
    "ios": {
      "modulesProvider": {
        "NativeModulaHost": "ModulaHostBridge"
      }
    }
  }
}
