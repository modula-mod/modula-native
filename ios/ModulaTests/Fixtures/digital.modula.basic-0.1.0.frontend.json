{
  "$schema": "https://modula.digital/schemas/product-standard/1.0/frontend.schema.json",
  "accessibility": {
    "declaration": "host-baseline-with-product-semantics",
    "keyboardNavigation": true,
    "reduceMotion": true,
    "scalableText": true,
    "screenReader": true
  },
  "actions": [
    {
      "family": "route.open",
      "id": "openSettings",
      "label": "Open settings",
      "route": "/settings"
    },
    {
      "family": "settings.update",
      "id": "saveSettings",
      "label": "Save settings",
      "settingsKey": "basic.preferences"
    },
    {
      "family": "dismiss",
      "id": "dismiss",
      "label": "Dismiss"
    }
  ],
  "entry": "home",
  "frontendSchemaVersion": "1.0.0",
  "hostRuntime": {
    "versionRange": ">=1.0.0 <2.0.0"
  },
  "mode": "declarative",
  "mpsVersion": "1.0",
  "navigation": {
    "backBehavior": "host",
    "rootView": "home",
    "tabs": [
      {
        "icon": "system.house",
        "id": "home",
        "label": "Home",
        "viewId": "home"
      },
      {
        "icon": "system.gear",
        "id": "settings",
        "label": "Settings",
        "viewId": "settings"
      }
    ]
  },
  "platformRequirements": {
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  },
  "productId": "digital.modula.basic",
  "releaseVersion": "0.1.0",
  "routes": [
    {
      "path": "/",
      "viewId": "home"
    },
    {
      "path": "/settings",
      "viewId": "settings"
    }
  ],
  "schema": "modula.frontend.1.0",
  "settings": {
    "viewId": "settings"
  },
  "views": [
    {
      "id": "home",
      "kind": "dashboard",
      "root": {
        "accessibility": {
          "label": "Basic Test home"
        },
        "children": [
          {
            "text": "Welcome to Basic Test",
            "type": "text"
          },
          {
            "text": "Minimal generated module",
            "type": "label"
          },
          {
            "accessibility": {
              "label": "Basic Test navigation"
            },
            "children": [
              {
                "action": "openSettings",
                "text": "Open settings",
                "type": "button"
              }
            ],
            "type": "toolbar"
          }
        ],
        "type": "section"
      },
      "states": {
        "capabilityUnavailable": {
          "accessibility": {
            "role": "status"
          },
          "text": "CAPABILITY_UNAVAILABLE",
          "type": "errorState"
        },
        "empty": {
          "text": "Basic Test has nothing to show yet.",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Basic Test could not be loaded.",
          "type": "errorState"
        },
        "loading": {
          "accessibility": {
            "role": "status"
          },
          "text": "Loading Basic Test",
          "type": "loadingState"
        },
        "permissionDenied": {
          "accessibility": {
            "role": "status"
          },
          "text": "This surface needs a permission the user has not granted.",
          "type": "errorState"
        }
      },
      "title": "Basic Test"
    },
    {
      "bindings": [
        {
          "id": "preferences",
          "settingsKey": "basic.preferences",
          "source": "settings"
        }
      ],
      "id": "settings",
      "kind": "settings",
      "root": {
        "accessibility": {
          "label": "Basic Test settings",
          "role": "form"
        },
        "children": [
          {
            "binding": "preferences",
            "field": {
              "id": "compactHome",
              "label": "Compact home",
              "type": "boolean"
            },
            "type": "field"
          },
          {
            "action": "saveSettings",
            "text": "Save",
            "type": "button"
          }
        ],
        "type": "section"
      },
      "states": {
        "capabilityUnavailable": {
          "accessibility": {
            "role": "status"
          },
          "text": "CAPABILITY_UNAVAILABLE",
          "type": "errorState"
        },
        "empty": {
          "text": "Settings are empty.",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Settings could not be loaded.",
          "type": "errorState"
        },
        "loading": {
          "accessibility": {
            "role": "status"
          },
          "text": "Loading settings",
          "type": "loadingState"
        },
        "permissionDenied": {
          "accessibility": {
            "role": "status"
          },
          "text": "This surface needs a permission the user has not granted.",
          "type": "errorState"
        }
      },
      "title": "Basic Test settings"
    }
  ]
}
